# ============================================
# CONFIGURAÇÕES DO TESTE K6
# ============================================
# Número de usuários virtuais simultâneos
VUS=5

# Duração do teste (ex: 1m, 5m, 30s, 1h)
DURATION=1m

# Ambiente de execução (dev, staging, production, ci)
ENVIRONMENT=ci

# Tempo de espera entre requisições (think time) em segundos
THINK_TIME=1

# Timeout das requisições em segundos
REQUEST_TIMEOUT=30

# URL base da API a ser testada
API_BASE_URL=https://jsonplaceholder.typicode.com

# Endpoint a ser testado (relativo à API_BASE_URL)
API_ENDPOINT=/posts

# ============================================
# THRESHOLDS (Limites de Performance)
# ============================================
# Taxa máxima de erro permitida (0.01 = 1%, 0.05 = 5%)
MAX_ERROR_RATE=0.01

# Latência p95 máxima em milissegundos
MAX_P95_LATENCY=500

# Latência p99 máxima em milissegundos
MAX_P99_LATENCY=1000

# Throughput mínimo (requisições por segundo)
MIN_THROUGHPUT=0

# ============================================
# CONFIGURAÇÕES DO INFLUXDB
# ============================================
# URL do InfluxDB (usado apenas localmente)
# No GitHub Actions, o InfluxDB é configurado automaticamente
INFLUXDB_URL=http://localhost:8086
INFLUXDB_DATABASE=k6_metrics
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=admin123456

# ============================================
# CONFIGURAÇÕES DO GRAFANA
# ============================================
# Porta do Grafana (usado apenas localmente)
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ============================================
# CONFIGURAÇÕES DO NGROK (Opcional)
# ============================================
# Token do ngrok para exposição pública (opcional)
# Obtenha em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

